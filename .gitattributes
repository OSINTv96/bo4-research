* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
# Source/provenance hashes cover literal bytes, including original newlines.
# Keep the normal whitespace checks, with CR recognized as part of CRLF.
src/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
provenance/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
